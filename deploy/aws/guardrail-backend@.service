# agent-guardrail service backend (Google sign-in, account, projects ; 127.0.0.1:8030) — systemd unit (DM-108).
# Installed as /etc/systemd/system/guardrail-backend@.service by deploy (slots.sh).
# C-19-11 : a template unit, one instance per slot (guardrail-backend@a, guardrail-backend@b). The slot's release is the symlink
# /opt/guardrail/slots/%i and its ports come from /etc/guardrail/slot-%i.env (both written by deploy/aws/slots.sh), so a
# new version starts beside the running one and Caddy moves to it only after it answers.
# /etc/guardrail/backend.env holds GUARDRAIL_DB_URL (Unix socket, peer authentication as user guardrail : no password),
# GOOGLE_CLIENT_ID (public OAuth client ID, from target.env), GOOGLE_LOGIN_URI and AUTH_COOKIE_SECURE.
# One worker only : sign-in sessions live in this process's memory (backend/auth/service.py). Restart signs everyone out,
# and so does a deploy (the new slot is a new process ; PM 11/17 : signing in again after a deploy is accepted).
[Unit]
Description=agent-guardrail service backend (Google sign-in, loopback), slot %i
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=guardrail
Group=guardrail
WorkingDirectory=/opt/guardrail/slots/%i
EnvironmentFile=/etc/guardrail/backend.env
EnvironmentFile=/etc/guardrail/slot-%i.env
ExecStart=/opt/guardrail/venv/bin/python -B -m uvicorn backend.main:app --host 127.0.0.1 --port ${GUARDRAIL_BACKEND_PORT} --workers 1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
