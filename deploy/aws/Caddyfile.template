# agent-guardrail demo server — Caddy (C-19-7, DM-91). Installed as /etc/caddy/Caddyfile by deploy (remote-install.sh).
# No value is filled in here : {$GUARDRAIL_DOMAIN} comes from /etc/guardrail/caddy.env (root, 600 ; a systemd drop-in
# hands it to caddy.service), written by remote-install.sh from deploy/aws/target.env.
# DM-109 : no shared site password any more. DM-110 : the whole site is behind Google sign-in (forward_auth below) ;
# only the sign-in page, the sign-in API and the sign-in page's own JS · CSS open without it.
# C-19-10 (DM-111 · DM-114) : the screen is the React build (site/, a single-page app) ; /login is React too.
# C-19-11 (DM-122) : the three services run in two slots (a : 8020 · 8030 · 8050, b : 8021 · 8031 · 8051). caddy.env names
# the slot in use ({$GUARDRAIL_*_UPSTREAM}, written by slots.sh) ; a deploy starts the other slot, checks it, rewrites
# those three lines and reloads Caddy (no dropped connection). Without the lines : slot a's ports.

{$GUARDRAIL_DOMAIN} {
	# HTTPS : Caddy gets the certificate for the domain by itself.
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# --- DM-110 : sign-in first. Every request except the sign-in page, the sign-in API and the built JS · CSS
	# (/assets/*, which the sign-in page itself needs ; no data in them) asks the backend ; no active session = the
	# backend's 303 to /login goes back to the browser. forward_auth runs before the handle blocks. ---
	# C-19-9 : the service gateway paths (below) are protected by the MAG API key the gateway itself checks, not by sign-in.
	@gated not path /login /api/auth/* /assets/* /v1/* /sessions /sessions/* /log /conditions
	forward_auth @gated {$GUARDRAIL_BACKEND_UPSTREAM:127.0.0.1:8030} {
		uri /api/auth/check
	}

	# --- service backend (DM-108, 127.0.0.1:8030) : sign-in API, the user's projects, their keys (C-19-8K), the provider list (C-19-8P) ---
	# Before @api : /api/auth/*, /api/projects*, /api/keys/* and /api/providers would otherwise fall into /api/*.
	# C-19-9 : /api/live/* is the live dashboard (the user's gateway sessions from the DB).
	@backend path /api/auth/* /api/projects /api/projects/* /api/keys/* /api/providers /api/live/*
	handle @backend {
		reverse_proxy {$GUARDRAIL_BACKEND_UPSTREAM:127.0.0.1:8030}
	}

	# --- C-19-10 : the frozen reference data the React screen reads (built into the bundle by bundle.py) ---
	handle /api/frontend/reference {
		root * /opt/guardrail/app/site
		rewrite * /reference.json
		header Cache-Control "no-store"
		file_server
	}

	# --- query API (C-19-6, read-only, 127.0.0.1:8020) : only these paths go to the API ---
	@api path /api/* /docs /redoc /openapi.json
	handle @api {
		reverse_proxy {$GUARDRAIL_API_UPSTREAM:127.0.0.1:8020}
	}

	# --- C-19-9 : service gateway (service/gateway.py, 127.0.0.1:8050). The customer's agent calls /v1/chat/completions
	# with its MAG API key (X-Guardrail-Key) ; the runner also uses /sessions*, /log and /conditions. No sign-in here :
	# the gateway answers 401 without a valid key. One model turn can take minutes (the proxy waits up to 600 s for
	# the upstream), so Caddy waits 660 s. Bodies over 8 MB are refused (the gateway's own limit is the same).
	# No access log is configured for this site : the key header never reaches a Caddy log. ---
	@gateway path /v1/* /sessions /sessions/* /log /conditions
	handle @gateway {
		request_body {
			max_size 8MB
		}
		# C-19-11 : only a gateway marks a request it hands to the other slot ; a caller cannot.
		request_header -X-Guardrail-Peer
		reverse_proxy {$GUARDRAIL_GATEWAY_UPSTREAM:127.0.0.1:8050} {
			transport http {
				dial_timeout 10s
				response_header_timeout 660s
				read_timeout 660s
				write_timeout 660s
			}
		}
	}

	# --- React screen (static files, built on the PM's computer). Hashed JS · CSS are cached ; a missing one is a 404,
	# never the page. Everything else : the file if there is one, else index.html (single-page app), never cached
	# (bundle files carry no date, so a cached page could point at assets the next release removed). /legacy/ is the
	# old Python screen kept for the presentation. ---
	handle /assets/* {
		root * /opt/guardrail/app/site
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /opt/guardrail/app/site
		header Cache-Control "no-cache"
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
